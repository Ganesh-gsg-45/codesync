# ============================================================
# CodeSync – Environment Variables Example
# Copy this file to .env (backend) or .env.local (frontend)
# and fill in your actual values. NEVER commit real secrets.
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/codesync?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=codesync_user
DB_PASSWORD=your_secure_db_password_here

# ── JWT ─────────────────────────────────────────────────────
# Generate a strong secret (512-bit minimum):
#   openssl rand -base64 64
JWT_SECRET=your_very_long_base64_encoded_jwt_secret_here_minimum_512_bits
JWT_EXPIRATION_MS=86400000

# ── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend (Vite) ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
